# 统一行尾，避免 Windows 上反复出现整个文件被改写。
* text=auto

.gitignore       text eol=lf
.gitattributes   text eol=lf
.editorconfig    text eol=lf
LICENSE          text eol=lf
LICENSE.*        text eol=lf

*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.html  text eol=lf

# Windows 脚本保持 CRLF，否则某些宿主会报错。
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
