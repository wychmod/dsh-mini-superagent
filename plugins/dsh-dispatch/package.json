{
  "name": "dsh-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "后台任务派发：主会话把任务派给独立的子会话执行，子会话完成后自动汇报回主会话。",
  "icon": "icon.svg",
  "author": "dsh-dispatch",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
