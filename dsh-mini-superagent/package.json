{
  "name": "dsh-mini-superagent",
  "version": "0.10.0",
  "description": "DSH 任务派发与工作台：主会话把任务派给独立后台子会话，立即返回、报告自动回流；侧边栏「派发工作台」看并发、排队、批次进度与失败原因，可取消、重试、归档。",
  "icon": "icon.svg",
  "author": "wychmod",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wychmod/dsh-mini-superagent.git"
  },
  "bugs": {
    "url": "https://github.com/wychmod/dsh-mini-superagent/issues"
  },
  "homepage": "https://github.com/wychmod/dsh-mini-superagent#readme",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check:dev": "node scripts/check-syntax.mjs && node --test && node ../scripts/client-smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "bundle",
    "agent",
    "task",
    "dispatch",
    "subagent",
    "orchestration",
    "task-board"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    },
    "manifestVersion": 1
  }
}
